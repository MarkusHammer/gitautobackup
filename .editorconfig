# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

[*]
indent_style = space
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true
charset = utf-8

[*.py, *.pyi]
indent_size = 4
indent_style = space

[.flake8, .editorconfig, **.yaml, **.toml]
indent_size = 2
indent_style = space
